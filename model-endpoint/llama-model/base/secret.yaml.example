apiVersion: v1
kind: Secret
metadata:
  name: model-secrets
  namespace: model-serving
  labels:
    app: llm-model
type: Opaque
stringData:
  # Example: Hugging Face API token for downloading private models
  hf.token: "your-huggingface-token-here"
  # Example: API key for authenticating requests to the model endpoint
  api.key: "your-api-key-here"
